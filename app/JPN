'use client'
import { useEffect, useMemo, useState } from 'react'
import { useRouter } from 'next/navigation'
import { supabase } from '@/lib/supabase'
import { Shell, Metric, Msg } from '@/components/Shell'
import { JPN_SESSION, KOD_DAERAH, PPD_MAP, fetchAll, kodPusatOf, noSurat, normPusat, sekAsalOf, simpanExcel, statusOf } from '@/lib/helpers'

const MENU = [
  ['dashboard', '📊 Dashboard JPN'], ['template', '📄 Template Surat JPN (11 Jawatan)'], ['sekolah', '🏫 Semua Sekolah'],
  ['pusat', '📍 Pusat Master'], ['guru', '👨‍🏫 Guru Master'], ['cadangan', '📋 Semua Cadangan'],
  ['export', '📥 Export Negeri'], ['admin', '⚙️ Admin'], ['keluar', '🚪 Log Keluar'],
] as const

const JAWATAN_11 = ['KETUA PENGAWAS', 'TIMBALAN KETUA PENGAWAS', 'PENGAWAS PEPERIKSAAN', 'JURU TULIS', 'JURU BACA', 'KETUA PENGAWAS HOSPITAL',
  'PENGAWAS HOSPITAL', 'PENGAWAS PENGIRING', 'PENGEMAS BILIK', 'PENYELIA KAWASAN', 'SELENGGARA BILIK KEBAL']

const DEFAULT_TMPL = (j: string) => `<div style="font-family:Arial;padding:25px;border:1px solid #000;line-height:1.6">
<div style="text-align:center;border-bottom:3px double #000;padding-bottom:10px"><b>JABATAN PENDIDIKAN NEGERI SELANGOR</b><br>PEJABAT PENDIDIKAN DAERAH {{PPD}} - {{PPD_NAME}}</div>
<p>No Surat: {{NO_SURAT}}<br>Tarikh: {{TARIKH}}</p><p><b>{{NAMA}}</b><br>No. IC: {{IC}}<br>{{NAMA_SEKOLAH_ASAL}}</p>
<p><b>PELANTIKAN SEBAGAI ${j} PEPERIKSAAN SPM TAHUN 2026</b></p>
<p>Dengan hormatnya saya merujuk kepada perkara di atas. Tuan/puan dilantik sebagai ${j} di pusat <b>{{PUSAT}} - {{NAMA_PUSAT}}</b>.</p>
<p>Sekian.</p><p><b>MALAYSIA MADANI<br>BERKHIDMAT UNTUK NEGARA</b></p></div>`

const PAPAR_PREVIEW: Record<string, string> = {
  '{{NAMA}}': 'ALI BIN ABU', '{{IC}}': '800101-01-1234', '{{PUSAT}}': 'BA001', '{{NAMA_PUSAT}}': 'SMK CONTOH', '{{NO_SURAT}}': 'JPN.SEL/PPD.BA/SPM/2026/0001',
  '{{PPD}}': 'BA', '{{PPD_NAME}}': 'Klang', '{{TARIKH}}': new Date().toLocaleDateString('ms-MY'), '{{NAMA_SEKOLAH_ASAL}}': 'SMK ASAL',
}

export default function JpnPage() {
  const router = useRouter()
  const [ok, setOk] = useState(false)
  const [menu, setMenu] = useState('dashboard')
  const [msg, setMsg] = useState('')
  const [kira, setKira] = useState<Record<string, number>>({})
  const [ppdKira, setPpdKira] = useState<any[]>([])
  const [sekolah, setSekolah] = useState<any[]>([])
  const [pusat, setPusat] = useState<any[]>([])
  const [guru, setGuru] = useState<any[]>([])
  const [cad, setCad] = useState<any[]>([])
  const [tmpl, setTmpl] = useState<Record<string, string>>({})
  const [pilihJ, setPilihJ] = useState(JAWATAN_11[0])
  const [edit, setEdit] = useState('')
  const [preview, setPreview] = useState(false)
  const [fPpd, setFPpd] = useState('')
  const [cari, setCari] = useState('')
  const [adminStat, setAdminStat] = useState<any[]>([])

  async function jumlah(t: string, f?: (q: any) => any) {
    let q = supabase.from(t).select('*', { count: 'exact', head: true })
    if (f) q = f(q)
    const { count, error } = await q
    return error ? -1 : count || 0
  }

  async function muat() {
    const k: Record<string, number> = {}
    for (const t of ['sekolah_master', 'pusat_master', 'guru_master', 'cadangan_sup']) k[t] = await jumlah(t)
    setKira(k)
    setPpdKira(await Promise.all(KOD_DAERAH.map(async p => ({
      PPD: `${p} - ${PPD_MAP[p]}`,
      Sekolah: await jumlah('sekolah_master', q => q.eq('kod_ppd', p)),
      Guru: await jumlah('guru_master', q => q.ilike('kod_ppd', p)),
      Cadangan: await jumlah('cadangan_sup', q => q.eq('kod_ppd', p)),
    }))))
    const { data } = await supabase.from('surat_templates_jpn').select('jawatan,template_html')
    const tm: Record<string, string> = {}
    ;(data || []).forEach((x: any) => { tm[String(x.jawatan).toUpperCase().trim()] = x.template_html })
    setTmpl(tm)
  }

  useEffect(() => {
    if (!sessionStorage.getItem(JPN_SESSION)) return void router.replace('/')
    setOk(true); muat()
  }, []) // eslint-disable-line

  useEffect(() => { setEdit(tmpl[pilihJ] || DEFAULT_TMPL(pilihJ)) }, [pilihJ, tmpl])

  // muat data jadual hanya bila menu berkenaan dibuka
  useEffect(() => {
    if (!ok) return
    if (menu === 'sekolah' && !sekolah.length) fetchAll(() => supabase.from('sekolah_master').select('*').order('kod_ppd')).then(setSekolah)
    if (menu === 'pusat' && !pusat.length) fetchAll(() => supabase.from('pusat_master').select('*')).then(r => setPusat(r.map(normPusat)))
    if (menu === 'guru' && !guru.length) fetchAll(() => supabase.from('guru_master').select('id,kod_ppd,kod_sekolah,nama_guru,ic_guru,jawatan_cadangan')).then(setGuru)
    if (menu === 'cadangan' && !cad.length) fetchAll(() => supabase.from('cadangan_sup').select('*').order('id')).then(setCad)
    if (menu === 'admin') Promise.all(['sekolah_master', 'pusat_master', 'guru_master', 'cadangan_sup', 'surat_templates_jpn'].map(async t => ({ t, n: await jumlah(t) }))).then(setAdminStat)
  }, [menu, ok]) // eslint-disable-line

  async function simpanTemplate() {
    const { data } = await supabase.from('surat_templates_jpn').select('id').eq('jawatan', pilihJ)
    const { error } = data?.length
      ? await supabase.from('surat_templates_jpn').update({ template_html: edit }).eq('jawatan', pilihJ)
      : await supabase.from('surat_templates_jpn').insert({ jawatan: pilihJ, template_html: edit })
    setMsg(error ? '❌ ' + error.message : `✅ ${pilihJ} disimpan - PPD & SUP akan guna template ini`)
    if (!error) setTmpl({ ...tmpl, [pilihJ]: edit })
  }

  function pilihMenu(k: string) {
    if (k === 'keluar') { sessionStorage.removeItem(JPN_SESSION); router.push('/'); return }
    setMsg(''); setMenu(k)
  }
  if (!ok) return <div className="wrap">Memuatkan...</div>

  const ppdOf = (r: any) => String(r.kod_ppd || '').toUpperCase()
  const sekTapis = sekolah.filter(s => (!fPpd || ppdOf(s) === fPpd) && (!cari || `${s.kod_sekolah} ${s.nama_sekolah}`.toLowerCase().includes(cari.toLowerCase())))
  const pusTapis = pusat.filter(p => (!fPpd || p.no.startsWith(fPpd)) && (!cari || `${p.no} ${p.nama}`.toLowerCase().includes(cari.toLowerCase())))
  const guruTapis = guru.filter(g => (!fPpd || ppdOf(g) === fPpd) && (!cari || `${g.nama_guru} ${g.ic_guru} ${g.kod_sekolah}`.toLowerCase().includes(cari.toLowerCase())))
  const cadTapis = cad.filter(c => (!fPpd || ppdOf(c) === fPpd) && (!cari || `${c.nama_guru} ${c.ic_guru} ${sekAsalOf(c)}`.toLowerCase().includes(cari.toLowerCase())))

  const Penapis = () => (
    <div className="row">
      <div><label>PPD</label><select className="input" value={fPpd} onChange={e => setFPpd(e.target.value)}><option value="">Semua PPD</option>{KOD_DAERAH.map(p => <option key={p} value={p}>{p} - {PPD_MAP[p]}</option>)}</select></div>
      <div><label>Cari</label><input className="input" value={cari} onChange={e => setCari(e.target.value)} placeholder="Taip untuk cari..." /></div>
    </div>
  )
  const Had = ({ n, j }: { n: number; j: number }) => n > 500 ? <div className="muted" style={{ margin: '6px 0' }}>Memaparkan 500 pertama daripada {n}. Gunakan penapis atau Export untuk semua.</div> : null

  return (
    <Shell title="🏛️ JPN Selangor" sub="Jabatan Pendidikan Negeri" items={MENU} active={menu} onPick={pilihMenu} onRefresh={muat}>
      {menu === 'dashboard' && (<>
        <h2>Dashboard JPN Selangor - Pelantikan SPM 2026</h2>
        <div className="metrics">{(Object.entries(kira) as [string, number][]).map(([t, n]) => <Metric key={t} label={t} value={n < 0 ? 'ralat' : n} />)}</div>
        <div className="card"><h3>Breakdown Ikut PPD</h3><table><thead><tr><th>PPD</th><th>Sekolah</th><th>Guru</th><th>Cadangan</th></tr></thead>
          <tbody>{ppdKira.map(r => <tr key={r.PPD}><td>{r.PPD}</td><td>{r.Sekolah}</td><td>{r.Guru}</td><td>{r.Cadangan}</td></tr>)}</tbody></table></div>
      </>)}

      {menu === 'template' && (<>
        <h2>📄 Template Surat JPN - 11 Jawatan</h2>
        <div className="muted">JPN selaraskan template. PPD dan SUP auto guna template ini bila cetak surat.</div>
        <div className="info" style={{ margin: '10px 0' }}>Placeholder: {'{{NAMA}} {{IC}} {{JAWATAN}} {{SEKOLAH_ASAL}} {{NAMA_SEKOLAH_ASAL}} {{PUSAT}} {{NAMA_PUSAT}} {{NO_SURAT}} {{PPD}} {{PPD_NAME}} {{TARIKH}}'}</div>
        <Msg msg={msg} />
        <label>Pilih Jawatan {tmpl[pilihJ] ? '✅ (sudah disimpan)' : '(guna default)'}</label>
        <select className="input" value={pilihJ} onChange={e => setPilihJ(e.target.value)}>{JAWATAN_11.map(j => <option key={j}>{j}</option>)}</select>
        <label>Template HTML</label>
        <textarea className="input" style={{ height: 280, fontFamily: 'monospace', fontSize: 12 }} value={edit} onChange={e => setEdit(e.target.value)} />
        <div className="row"><button className="btn primary" style={{ marginTop: 0 }} onClick={simpanTemplate}>💾 Simpan {pilihJ}</button>
          <button className="btn" onClick={() => setEdit(DEFAULT_TMPL(pilihJ))}>↩️ Reset ke default</button>
          <label style={{ fontWeight: 400 }}><input type="checkbox" checked={preview} onChange={e => setPreview(e.target.checked)} /> Preview</label></div>
        {preview && <div className="card" dangerouslySetInnerHTML={{ __html: Object.entries(PAPAR_PREVIEW).reduce((h, [k, v]) => h.split(k).join(v), edit) }} />}
      </>)}

      {menu === 'sekolah' && (<><h2>Semua Sekolah ({sekTapis.length})</h2><Penapis />
        <button className="btn" onClick={() => simpanExcel(sekTapis.map(s => ({ KOD: s.kod_sekolah, NAMA: s.nama_sekolah, PPD: s.kod_ppd, 'BIL PUSAT': s.bil_pusat, PUSAT: s.senarai_pusat })), 'sekolah.xlsx')}>📥 Export</button>
        <Had n={sekTapis.length} j={0} />
        <div className="card" style={{ marginTop: 10 }}><div className="scroll"><table><thead><tr><th>Kod</th><th>Nama</th><th>PPD</th><th>Bil Pusat</th><th>Senarai Pusat</th></tr></thead>
          <tbody>{sekTapis.slice(0, 500).map(s => <tr key={s.id ?? s.kod_sekolah}><td className="mono">{s.kod_sekolah}</td><td>{s.nama_sekolah}</td><td>{s.kod_ppd}</td><td>{s.bil_pusat}</td><td>{s.senarai_pusat}</td></tr>)}</tbody></table></div></div></>)}

      {menu === 'pusat' && (<><h2>Pusat Master ({pusTapis.length})</h2><Penapis />
        <button className="btn" onClick={() => simpanExcel(pusTapis.map(p => ({ 'NO PUSAT': p.no, NAMA: p.nama, 'TUAN RUMAH': p.tuan, CALON: p.calon, KELAS: p.kelas, PERLU: p.sepatutnya })), 'pusat.xlsx')}>📥 Export</button>
        <Had n={pusTapis.length} j={0} />
        <div className="card" style={{ marginTop: 10 }}><div className="scroll"><table><thead><tr><th>No Pusat</th><th>Nama</th><th>Tuan Rumah</th><th>Calon</th><th>Kelas</th><th>Perlu</th></tr></thead>
          <tbody>{pusTapis.slice(0, 500).map(p => <tr key={p.no}><td className="mono">{p.no}</td><td>{p.nama}</td><td>{p.tuan}</td><td>{p.calon}</td><td>{p.kelas}</td><td>{p.sepatutnya}</td></tr>)}</tbody></table></div></div></>)}

      {menu === 'guru' && (<><h2>Guru Master ({guruTapis.length})</h2><Penapis /><Had n={guruTapis.length} j={0} />
        <div className="card"><div className="scroll"><table><thead><tr><th>Nama</th><th>IC</th><th>Sekolah</th><th>PPD</th><th>Jawatan</th></tr></thead>
          <tbody>{guruTapis.slice(0, 500).map(g => <tr key={g.id}><td>{g.nama_guru}</td><td className="mono">{g.ic_guru}</td><td>{g.kod_sekolah}</td><td>{g.kod_ppd}</td><td>{g.jawatan_cadangan}</td></tr>)}</tbody></table></div></div></>)}

      {menu === 'cadangan' && (<><h2>Semua Cadangan ({cadTapis.length})</h2><Penapis />
        <button className="btn" onClick={() => simpanExcel(cadTapis.map(c => ({ NAMA: c.nama_guru, IC: c.ic_guru, PPD: ppdOf(c), 'SEKOLAH ASAL': sekAsalOf(c), JAWATAN: c.jawatan_cadangan, PUSAT: kodPusatOf(c), STATUS: statusOf(c), 'NO SURAT': noSurat(c) })), 'cadangan.xlsx')}>📥 Export</button>
        <Had n={cadTapis.length} j={0} />
        <div className="card" style={{ marginTop: 10 }}><div className="scroll"><table><thead><tr><th>Nama</th><th>PPD</th><th>Sekolah Asal</th><th>Jawatan</th><th>Pusat</th><th>Status</th></tr></thead>
          <tbody>{cadTapis.slice(0, 500).map(c => <tr key={c.id}><td>{c.nama_guru}</td><td>{ppdOf(c)}</td><td>{sekAsalOf(c)}</td><td>{c.jawatan_cadangan}</td><td className="mono">{kodPusatOf(c)}</td><td>{statusOf(c)}</td></tr>)}</tbody></table></div></div></>)}

      {menu === 'export' && (<><h2>Export Laporan Negeri</h2>
        <button className="btn primary" style={{ width: 'auto', marginTop: 0 }} onClick={async () => {
          setMsg('Mengambil data...'); const semua = await fetchAll(() => supabase.from('cadangan_sup').select('*').order('id'))
          await simpanExcel(semua.map(c => ({ NAMA: c.nama_guru, IC: c.ic_guru, PPD: ppdOf(c), 'SEKOLAH ASAL': sekAsalOf(c), JAWATAN: c.jawatan_cadangan, PUSAT: kodPusatOf(c), STATUS: statusOf(c), 'NO SURAT': noSurat(c) })), `Laporan_JPN_Selangor_${new Date().toISOString().slice(0, 10)}.xlsx`)
          setMsg(`✅ ${semua.length} rekod dieksport`)
        }}>📥 Laporan Penuh Negeri (Excel)</button><Msg msg={msg} /></>)}

      {menu === 'admin' && (<><h2>⚙️ Status Sistem & Pangkalan Data</h2>
        {adminStat.map(s => <div key={s.t} className={s.n < 0 ? 'err' : 'ok'} style={{ margin: '6px 0' }}>{s.n < 0 ? '❌' : '✅'} {s.t}: {s.n < 0 ? 'tidak dapat diakses' : s.n + ' rekod'}</div>)}
        <div className="card" style={{ marginTop: 14 }}><h3>SQL jika jadual belum wujud (Supabase SQL Editor)</h3>
          <pre style={{ whiteSpace: 'pre-wrap', fontSize: 12, background: '#f8fafc', padding: 12, borderRadius: 8 }}>{`CREATE TABLE IF NOT EXISTS surat_templates_jpn (
  id SERIAL PRIMARY KEY, jawatan TEXT UNIQUE, template_html TEXT);

CREATE TABLE IF NOT EXISTS cadangan_sup (
  id BIGSERIAL PRIMARY KEY, kod_ppd TEXT, kod_sekolah TEXT, kod_sekolah_asal TEXT, nama_sekolah_asal TEXT,
  ic_guru TEXT, nama_guru TEXT, jantina TEXT, poskod_rumah TEXT, alamat_rumah TEXT, telefon_guru TEXT, email_guru TEXT,
  kod_pusat TEXT, jawatan_cadangan TEXT, pengalaman_spm TEXT, catatan TEXT, no_surat TEXT,
  status TEXT DEFAULT 'DICADANGKAN', tarikh_cadang DATE, created_at TIMESTAMPTZ DEFAULT NOW());

-- RLS (longgar - ketatkan untuk produksi)
ALTER TABLE cadangan_sup ENABLE ROW LEVEL SECURITY;
CREATE POLICY "allow all" ON cadangan_sup FOR ALL USING (true) WITH CHECK (true);
ALTER TABLE surat_templates_jpn ENABLE ROW LEVEL SECURITY;
CREATE POLICY "allow all" ON surat_templates_jpn FOR ALL USING (true) WITH CHECK (true);`}</pre></div></>)}
    </Shell>
  )
}
