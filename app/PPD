
'use client'
import { useEffect, useMemo, useState } from 'react'
import { useRouter } from 'next/navigation'
import { supabase } from '@/lib/supabase'
import { Shell, Metric, Msg, Banner } from '@/components/Shell'
import {
  PPD_MAP, PPD_SESSION, SURAT_LULUS, cetak, fetchAll, isHantar, isLulus, kodPusatOf, noSurat, nombor,
  normPusat, sekAsalOf, simpanExcel, statusOf, suratHtml,
} from '@/lib/helpers'

const MENU = [
  ['dashboard', '📊 Dashboard PPD'], ['sekolah', '🏫 Sekolah dalam PPD'], ['pusat', '📍 Pusat di PPD'],
  ['cadangan', '📋 Cadangan SUP'], ['tempat', '🚀 Penempatan Petugas'], ['kelulusan', '✅ Kelulusan & No Surat'],
  ['surat', '📄 Janaan Surat Lantikan'], ['export', '📥 Export'], ['keluar', '🚪 Log Keluar'],
] as const

export default function PpdPage() {
  const router = useRouter()
  const [kod, setKod] = useState('')
  const [menu, setMenu] = useState('dashboard')
  const [pusatRaw, setPusatRaw] = useState<any[]>([])
  const [sekolah, setSekolah] = useState<any[]>([])
  const [cadAll, setCadAll] = useState<any[]>([])
  const [guruKira, setGuruKira] = useState<Record<string, number>>({})
  const [tmpl, setTmpl] = useState<Record<string, string>>({})
  const [msg, setMsg] = useState('')
  const [busy, setBusy] = useState(false)
  // penempatan
  const [pilih, setPilih] = useState<number[]>([])
  const [pusatTarget, setPusatTarget] = useState('')
  const [cadangAuto, setCadangAuto] = useState<any[]>([])
  // kelulusan
  const [rujukan, setRujukan] = useState('')
  const [skop, setSkop] = useState('SEMUA')
  // lain
  const [fStatus, setFStatus] = useState('')
  const [fSek, setFSek] = useState('')
  const [fPusat, setFPusat] = useState('')

  const ok = (m: string) => setMsg('✅ ' + m)
  const ralat = (m: string) => setMsg('❌ ' + m)

  async function muat(k: string) {
    const [p, s, c, g, t] = await Promise.all([
      fetchAll(() => supabase.from('pusat_master').select('*')),
      fetchAll(() => supabase.from('sekolah_master').select('*').eq('kod_ppd', k)),
      fetchAll(() => supabase.from('cadangan_sup').select('*').eq('kod_ppd', k).order('id')),
      fetchAll(() => supabase.from('guru_master').select('kod_sekolah').ilike('kod_ppd', k)),
      supabase.from('surat_templates_jpn').select('jawatan,template_html'),
    ])
    setPusatRaw(p.filter(x => normPusat(x).no.startsWith(k)))
    setSekolah(s)
    setCadAll(c)
    const gk: Record<string, number> = {}
    g.forEach(x => { const ks = String(x.kod_sekolah || '').toUpperCase(); gk[ks] = (gk[ks] || 0) + 1 })
    setGuruKira(gk)
    const tm: Record<string, string> = {}
    ;(t.data || []).forEach((x: any) => { tm[String(x.jawatan).toUpperCase().trim()] = x.template_html })
    setTmpl(tm)
  }

  useEffect(() => {
    const k = sessionStorage.getItem(PPD_SESSION)
    if (!k) return void router.replace('/')
    setKod(k); setRujukan(`JPN.SEL/PPD.${k}/SPM/${new Date().getFullYear()}`); muat(k)
  }, []) // eslint-disable-line

  // PPD hanya nampak cadangan yang sudah dihantar atau diluluskan
  const cad = useMemo(() => cadAll.filter(c => isHantar(c) || isLulus(c)), [cadAll])
  const pusat = useMemo(() => pusatRaw.map(normPusat), [pusatRaw])
  const namaPusat = useMemo(() => Object.fromEntries(pusat.map(p => [p.no, p.nama])), [pusat])

  const ditempat = (no: string) => cad.filter(c => kodPusatOf(c) === no).length
  const belumTempat = cad.filter(c => !kodPusatOf(c) && !isLulus(c))
  const jumlah = (f: (p: any) => number) => pusat.reduce((a, p) => a + f(p), 0)
  const sepatutnya = jumlah(p => p.sepatutnya)
  const maxNo = cadAll.reduce((m, c) => Math.max(m, nombor(c)), 0)
  const [mula, setMula] = useState(0)
  useEffect(() => { setMula(maxNo + 1) }, [maxNo])

  const htmlSurat = (c: any) => suratHtml(c, kod, namaPusat[kodPusatOf(c)] || '', tmpl[String(c.jawatan_cadangan || '').toUpperCase().trim()])

  // ---------- PENEMPATAN ----------
  async function tetapPusat(ids: number[], no: string | null) {
    if (!ids.length) return
    setBusy(true)
    const { error } = await supabase.from('cadangan_sup').update({ kod_pusat: no }).in('id', ids)
    setBusy(false)
    error ? ralat(error.message) : ok(no ? `${ids.length} petugas ditempatkan di ${no}` : `${ids.length} penempatan dibuang`)
    setPilih([]); setCadangAuto([]); muat(kod)
  }

  function cadangAutoAgih() {
    const belum = [...belumTempat]
    const hasil: any[] = []
    const keperluan = pusat.map(p => ({ ...p, kurang: p.sepatutnya - ditempat(p.no) })).filter(p => p.kurang > 0).sort((a, b) => b.kurang - a.kurang)
    let ada = true
    while (ada && belum.length) {
      ada = false
      for (const p of keperluan) {
        if (p.kurang <= 0) continue
        const i = belum.findIndex(c => sekAsalOf(c) !== p.tuan)   // tidak boleh bertugas di sekolah asal
        if (i < 0) continue
        const [c] = belum.splice(i, 1)
        hasil.push({ id: c.id, nama: c.nama_guru, asal: sekAsalOf(c), pusat: p.no })
        p.kurang--; ada = true
      }
    }
    setCadangAuto(hasil)
    if (!hasil.length) setMsg('⚠️ Tiada cadangan sesuai untuk diagih secara auto.')
  }

  async function sahkanAuto() {
    setBusy(true)
    const ikutPusat: Record<string, number[]> = {}
    cadangAuto.forEach(h => (ikutPusat[h.pusat] ||= []).push(h.id))
    for (const [no, ids] of Object.entries(ikutPusat)) {
      const { error } = await supabase.from('cadangan_sup').update({ kod_pusat: no }).in('id', ids)
      if (error) { ralat(error.message); setBusy(false); return }
    }
    setBusy(false); ok(`${cadangAuto.length} petugas diagih ke ${Object.keys(ikutPusat).length} pusat`); setCadangAuto([]); muat(kod)
  }

  // ---------- KELULUSAN ----------
  const layak = cad.filter(c => kodPusatOf(c) && !isLulus(c) && (skop === 'SEMUA' || kodPusatOf(c) === skop))
  async function luluskan() {
    if (!layak.length) return
    if (!confirm(`Lulus ${layak.length} petugas dan jana no surat bermula ${mula}?`)) return
    setBusy(true); let n = mula, berjaya = 0
    for (let i = 0; i < layak.length; i += 20) {
      const kumpulan = layak.slice(i, i + 20)
      const res = await Promise.all(kumpulan.map(c => {
        const ns = `${rujukan.replace(/\/$/, '')}/${String(n++).padStart(4, '0')}`
        return supabase.from('cadangan_sup').update({ status: SURAT_LULUS, no_surat: ns }).eq('id', c.id)
      }))
      res.forEach(r => (r.error ? ralat(r.error.message) : berjaya++))
    }
    setBusy(false); ok(`${berjaya} petugas diluluskan. Surat sampai ke sekolah asal.`); muat(kod)
  }

  // ---------- SURAT ----------
  const lulusList = cad.filter(c => isLulus(c) && noSurat(c) && (!fPusat || kodPusatOf(c) === fPusat))

  function pilihMenu(k: string) {
    if (k === 'keluar') { sessionStorage.removeItem(PPD_SESSION); router.push('/'); return }
    setMsg(''); setMenu(k)
  }
  if (!kod) return <div className="wrap">Memuatkan...</div>

  const warnaKurang = (k: number, s: number) => (k >= s ? '#2e7d32' : k === 0 ? '#d32f2f' : '#f57f17')
  const cadTapis = cad.filter(c => (!fStatus || statusOf(c).includes(fStatus)) && (!fSek || sekAsalOf(c) === fSek) && (!fPusat || kodPusatOf(c) === fPusat))

  return (
    <Shell title={`🏢 PPD ${kod}`} sub={PPD_MAP[kod]} items={MENU} active={menu} onPick={pilihMenu} onRefresh={() => muat(kod)}>
      {menu === 'dashboard' && (<>
        <Banner bg="#0d47a1" title={`PPD ${kod} - ${PPD_MAP[kod]}`} sub="Dashboard Pelantikan SPM 2026 - Pusat & Keperluan Petugas" />
        {pusat.length === 0 ? <div className="info">⚠️ Tiada pusat dijumpai untuk PPD {kod}.</div> : (<>
          <div className="metrics">
            <Metric label="Pusat" value={pusat.length} /><Metric label="Calon" value={jumlah(p => p.calon)} /><Metric label="Kelas" value={jumlah(p => p.kelas)} />
            <Metric label="Petugas Diperlukan" value={sepatutnya} /><Metric label="Cadangan Diterima" value={cad.length} />
            <Metric label="Sudah Ditempatkan" value={cad.filter(c => kodPusatOf(c)).length} /><Metric label="Kekurangan" value={Math.max(0, sepatutnya - cad.length)} red />
          </div>
          <div className="card"><h3>📍 Keperluan Ikut Pusat</h3><div className="scroll"><table>
            <thead><tr><th>No Pusat</th><th>Nama Pusat</th><th>Tuan Rumah</th><th>Calon</th><th>Kelas</th><th>Perlu</th><th>Ditempatkan</th></tr></thead>
            <tbody>{pusat.map(p => { const d = ditempat(p.no); return <tr key={p.no}><td className="mono">{p.no}</td><td>{p.nama}</td><td>{p.tuan}</td><td>{p.calon}</td><td>{p.kelas}</td><td>{p.sepatutnya}</td>
              <td style={{ color: warnaKurang(d, p.sepatutnya), fontWeight: 800 }}>{d}</td></tr> })}</tbody></table></div></div></>)}
      </>)}

      {menu === 'sekolah' && (<>
        <h2>Sekolah dalam PPD {kod} ({sekolah.length})</h2>
        <div className="card" style={{ marginTop: 12 }}><div className="scroll"><table>
          <thead><tr><th>Kod</th><th>Nama Sekolah</th><th>Pusat</th><th>Guru</th><th>Cadangan</th></tr></thead>
          <tbody>{sekolah.map(s => { const k = String(s.kod_sekolah).toUpperCase(); return <tr key={s.id ?? k}><td className="mono">{k}</td><td>{s.nama_sekolah}</td><td>{s.senarai_pusat}</td>
            <td>{guruKira[k] || 0}</td><td>{cad.filter(c => String(c.kod_sekolah).toUpperCase() === k).length}</td></tr> })}</tbody></table></div></div>
      </>)}

      {menu === 'pusat' && (<>
        <h2>Pusat di PPD {kod} ({pusat.length})</h2>
        <button className="btn" onClick={() => simpanExcel(pusat.map(p => ({ 'NO PUSAT': p.no, NAMA: p.nama, 'TUAN RUMAH': p.tuan, CALON: p.calon, KELAS: p.kelas, PERLU: p.sepatutnya })), `pusat_${kod}.xlsx`)}>📥 Export Excel</button>
        <div className="card" style={{ marginTop: 12 }}><div className="scroll"><table>
          <thead><tr><th>No Pusat</th><th>Nama</th><th>Tuan Rumah</th><th>Calon</th><th>Kelas</th><th>Petugas Perlu</th></tr></thead>
          <tbody>{pusat.map(p => <tr key={p.no}><td className="mono">{p.no}</td><td>{p.nama}</td><td>{p.tuan}</td><td>{p.calon}</td><td>{p.kelas}</td><td>{p.sepatutnya}</td></tr>)}</tbody></table></div></div>
      </>)}

      {menu === 'cadangan' && (<>
        <h2>Cadangan SUP ({cadTapis.length}/{cad.length})</h2>
        <div className="row">
          <div><label>Status</label><select className="input" value={fStatus} onChange={e => setFStatus(e.target.value)}><option value="">Semua</option><option value="HANTAR">Hantar ke PPD</option><option value="LULUS">Lulus</option></select></div>
          <div><label>Sekolah Asal</label><select className="input" value={fSek} onChange={e => setFSek(e.target.value)}><option value="">Semua</option>{Array.from(new Set(cad.map(sekAsalOf))).sort().map(s => <option key={s}>{s}</option>)}</select></div>
          <div><label>Pusat</label><select className="input" value={fPusat} onChange={e => setFPusat(e.target.value)}><option value="">Semua</option>{pusat.map(p => <option key={p.no}>{p.no}</option>)}</select></div>
        </div>
        <div className="card"><div className="scroll"><table><thead><tr><th>Nama</th><th>IC</th><th>Jawatan</th><th>Sekolah Asal</th><th>Pusat</th><th>Status</th></tr></thead>
          <tbody>{cadTapis.map(c => <tr key={c.id}><td>{c.nama_guru}</td><td className="mono">{c.ic_guru}</td><td>{c.jawatan_cadangan}</td><td>{sekAsalOf(c)}</td><td className="mono">{kodPusatOf(c) || '-'}</td><td>{statusOf(c)}</td></tr>)}</tbody></table></div></div>
      </>)}

      {menu === 'tempat' && (<>
        <Banner bg="linear-gradient(135deg,#0d47a1,#1565c0)" title="🚀 Penempatan Petugas" sub="Tempatkan petugas ke pusat. Petugas tidak boleh ditempatkan di pusat sekolah asal sendiri." />
        <Msg msg={msg} />
        <div className="metrics"><Metric label="Belum Ditempatkan" value={belumTempat.length} /><Metric label="Sudah Ditempatkan" value={cad.filter(c => kodPusatOf(c) && !isLulus(c)).length} /><Metric label="Sudah Lulus" value={cad.filter(isLulus).length} /></div>

        <div className="card"><h3>Agihan Automatik</h3><div className="muted">Isi pusat yang kurang petugas, mengelak sekolah tuan rumah. (Tidak mengira jarak poskod.)</div>
          <div className="row"><button className="btn primary" style={{ width: 'auto', marginTop: 0 }} onClick={cadangAutoAgih} disabled={!belumTempat.length}>🔍 Semak Cadangan Agihan</button></div>
          {cadangAuto.length > 0 && <>
            <div className="scroll" style={{ maxHeight: 260 }}><table><thead><tr><th>Nama</th><th>Sekolah Asal</th><th>Pusat</th></tr></thead>
              <tbody>{cadangAuto.map(h => <tr key={h.id}><td>{h.nama}</td><td>{h.asal}</td><td className="mono">{h.pusat}</td></tr>)}</tbody></table></div>
            <button className="btn primary" disabled={busy} onClick={sahkanAuto}>✅ Sahkan {cadangAuto.length} Penempatan</button></>}
        </div>

        <div className="card" style={{ marginTop: 14 }}><h3>Penempatan Manual</h3>
          <div className="row"><div><label>Pilih Pusat</label><select className="input" value={pusatTarget} onChange={e => setPusatTarget(e.target.value)}>
            <option value="">-- pilih --</option>{pusat.map(p => <option key={p.no} value={p.no}>{p.no} - {p.nama.slice(0, 30)} ({ditempat(p.no)}/{p.sepatutnya})</option>)}</select></div>
            <div><button className="btn primary" style={{ marginTop: 0 }} disabled={!pilih.length || !pusatTarget || busy} onClick={() => {
              const tuan = pusat.find(p => p.no === pusatTarget)?.tuan
              const salah = cad.filter(c => pilih.includes(c.id) && sekAsalOf(c) === tuan)
              if (salah.length) return setMsg(`⚠️ ${salah.map(c => c.nama_guru).join(', ')} dari sekolah tuan rumah ${tuan} - tidak boleh.`)
              tetapPusat(pilih, pusatTarget)
            }}>📌 Tempatkan {pilih.length} petugas</button></div></div>
          <div className="scroll" style={{ maxHeight: 340 }}><table><thead><tr><th></th><th>Nama</th><th>Jawatan</th><th>Sekolah Asal</th><th>Pusat Semasa</th></tr></thead>
            <tbody>{cad.filter(c => !isLulus(c)).map(c => <tr key={c.id}>
              <td><input type="checkbox" checked={pilih.includes(c.id)} onChange={e => setPilih(e.target.checked ? [...pilih, c.id] : pilih.filter(x => x !== c.id))} /></td>
              <td>{c.nama_guru}</td><td>{c.jawatan_cadangan}</td><td>{sekAsalOf(c)}</td><td className="mono">{kodPusatOf(c) || '-'}</td></tr>)}</tbody></table></div>
          <button className="btn danger" disabled={!pilih.length} onClick={() => tetapPusat(pilih, null)}>↩️ Buang penempatan terpilih</button></div>
      </>)}

      {menu === 'kelulusan' && (<>
        <Banner bg="linear-gradient(135deg,#1b5e20,#2e7d32)" title={`✅ Kelulusan - PPD ${kod}`} sub="Luluskan petugas yang sudah ditempatkan dan jana no surat berturutan." />
        <Msg msg={msg} />
        <div className="card"><div className="grid2"><div>
          <label>Format Rujukan</label><input className="input" value={rujukan} onChange={e => setRujukan(e.target.value)} />
          <label>No Surat Bermula (no tertinggi sedia ada: {maxNo})</label><input className="input" type="number" value={mula} onChange={e => setMula(parseInt(e.target.value) || 1)} /></div><div>
          <label>Skop Kelulusan</label><select className="input" value={skop} onChange={e => setSkop(e.target.value)}><option value="SEMUA">Semua pusat</option>
            {pusat.filter(p => cad.some(c => kodPusatOf(c) === p.no && !isLulus(c))).map(p => <option key={p.no} value={p.no}>{p.no} - {p.nama.slice(0, 30)}</option>)}</select>
          <div className="info" style={{ marginTop: 14 }}>Contoh no surat: <b>{rujukan.replace(/\/$/, '')}/{String(mula).padStart(4, '0')}</b></div></div></div>
          <button className="btn primary" disabled={!layak.length || busy} onClick={luluskan}>{busy ? 'Memproses...' : `✅ Lulus ${layak.length} petugas & jana no surat`}</button></div>
        {layak.length === 0 && <div className="info" style={{ marginTop: 12 }}>Tiada petugas menunggu kelulusan. Tempatkan petugas ke pusat dahulu.</div>}
      </>)}

      {menu === 'surat' && (<>
        <Banner bg="linear-gradient(135deg,#4a148c,#7b1fa2)" title="📄 Janaan Surat Lantikan" sub="Cetak, kemudian pilih Save as PDF. Surat turut kelihatan di SUP sekolah asal." />
        <div className="row"><div><label>Pusat</label><select className="input" value={fPusat} onChange={e => setFPusat(e.target.value)}><option value="">Semua pusat</option>
          {Array.from(new Set(cad.filter(isLulus).map(kodPusatOf))).sort().map(p => <option key={p}>{p}</option>)}</select></div>
          <div><button className="btn primary" style={{ marginTop: 0 }} disabled={!lulusList.length} onClick={() => cetak(lulusList.map(htmlSurat))}>🖨️ Cetak / PDF {lulusList.length} surat</button></div></div>
        <div className="card"><div className="scroll"><table><thead><tr><th>Nama</th><th>Jawatan</th><th>Sekolah Asal</th><th>Pusat</th><th>No Surat</th><th></th></tr></thead>
          <tbody>{lulusList.map(c => <tr key={c.id}><td>{c.nama_guru}</td><td>{c.jawatan_cadangan}</td><td>{sekAsalOf(c)}</td><td className="mono">{kodPusatOf(c)}</td><td>{noSurat(c)}</td>
            <td><button className="btn" style={{ padding: '4px 10px', fontSize: 12 }} onClick={() => cetak([htmlSurat(c)])}>🖨️</button></td></tr>)}</tbody></table></div></div>
      </>)}

      {menu === 'export' && (<>
        <h2>Export PPD {kod}</h2>
        <div className="row">
          <button className="btn primary" style={{ width: 'auto', marginTop: 0 }} onClick={() => simpanExcel(cad.map(c => ({ NAMA: c.nama_guru, IC: c.ic_guru, JAWATAN: c.jawatan_cadangan, 'SEKOLAH ASAL': sekAsalOf(c), PUSAT: kodPusatOf(c), STATUS: statusOf(c), 'NO SURAT': noSurat(c) })), `laporan_PPD_${kod}.xlsx`)}>📥 Laporan Penuh PPD (Excel)</button>
          <button className="btn" onClick={() => simpanExcel(pusat.map(p => ({ 'NO PUSAT': p.no, NAMA: p.nama, CALON: p.calon, KELAS: p.kelas, PERLU: p.sepatutnya, DITEMPATKAN: ditempat(p.no) })), `pusat_${kod}.xlsx`)}>📥 Ringkasan Pusat</button></div>
      </>)}
    </Shell>
  )
}
